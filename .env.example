# Copy to .env.local and edit. Only EXPO_PUBLIC_* variables reach the app bundle — never put secrets here.
# Q Bank API base URL (with the /api/v1 prefix). Defaults to production when unset.
EXPO_PUBLIC_API_URL=https://back-q-bank.vodat10998.workers.dev/api/v1

# Local backend (`npm run dev` in back_q_bank):
#   Android emulator:        http://10.0.2.2:8787/api/v1
#   USB device (adb reverse): http://localhost:8787/api/v1   (adb reverse tcp:8787 tcp:8787)
#   Device on the same Wi-Fi: http://<your-LAN-IP>:8787/api/v1 (run `npx wrangler dev --ip 0.0.0.0`)
